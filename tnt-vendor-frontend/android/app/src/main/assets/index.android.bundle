   * class App extends Component {
   *   state = { count: 0 }
   *
   *   onPress = () => {
   *     this.setState(state => ({
   *       count: state.count + 1
   *     }));
   *   };
   *
   *  render() {
   *    return (
   *      <View style={styles.container}>
   *        <TouchableOpacity
